# Copie para um arquivo .env local e nunca versione o arquivo com valores reais.
SPRING_PROFILES_ACTIVE=dev
PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/odr
DB_USER=odr
DB_PASSWORD=odr

# CORS: origens permitidas do frontend, separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini API (crie a chave no Google AI Studio; não envie este arquivo ao Git).
GEMINI_API_KEY=cole_sua_chave_aqui
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.1-flash-lite
AI_TEMPERATURE=0.4
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=60s
AI_MAX_RETRIES=1
