# Copie para .env (nunca commite o .env) e ajuste os valores.
SPRING_PROFILES_ACTIVE=dev
PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/odr
DB_USER=odr
DB_PASSWORD=odr

# Origens permitidas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# IA (Ollama). No Docker Compose, o serviço Ollama já é iniciado automaticamente.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.4
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=120s
