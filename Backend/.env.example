# Copie para um arquivo .env local e nunca versione o arquivo com valores reais.
SPRING_PROFILES_ACTIVE=dev
PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/odr
DB_USER=odr
DB_PASSWORD=odr

# CORS: origens permitidas do frontend, separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Ollama Cloud: crie sua chave em https://ollama.com/settings/keys.
OLLAMA_API_KEY=cole_sua_chave_aqui
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
AI_MODEL=gpt-oss:20b
AI_TEMPERATURE=0.4
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=60s
AI_MAX_RETRIES=1
